{
  "description": "Restore VibeWise learning context when an agent session starts or resumes.",
  "vibe-wise-session": {
    "SessionStart": [
      {
        "type": "command",
        "command": "python3 hooks/session_start.py",
        "timeout": 10
      }
    ],
    "PreInvocation": [
      {
        "type": "command",
        "command": "python3 hooks/session_start.py",
        "timeout": 10
      }
    ]
  }
}
