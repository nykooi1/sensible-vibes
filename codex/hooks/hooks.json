{
  "description": "Restore local VibeWise learning context in Codex when a session starts or compacts.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/codex/hooks/session_start.py\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
