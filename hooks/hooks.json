{
  "description": "Restore local VibeWise learning context when a session starts or compacts.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact|fork",
        "hooks": [
          {
            "type": "command",
            "command": "exec sh \"${CLAUDE_PLUGIN_ROOT}/hooks/session_start.sh\"; powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -File \"${CLAUDE_PLUGIN_ROOT}/hooks/session_start.ps1\"; exit 0",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
